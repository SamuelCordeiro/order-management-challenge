RABBITMQ_RETRY_ROUTING_KEY=order.created.v1.retry
RABBITMQ_RETRY_DELAY_MILLISECONDS=5000
RABBITMQ_MAX_DELIVERY_ATTEMPTS=3
RABBITMQ_STATUS_EXCHANGE=order.status.events
RABBITMQ_STATUS_QUEUE=order.status.changed.v1
