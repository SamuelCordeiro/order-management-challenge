# Docker Compose: copie este arquivo para .env e substitua os valores locais.
POSTGRES_DB=orders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=order.events
RABBITMQ_QUEUE=order.created
RABBITMQ_ROUTING_KEY=order.created

# Execução direta via dotnet: exporte esta variável ou configure User Secrets.
ConnectionStrings__OrdersDatabase=Host=localhost;Port=5432;Database=orders;Username=postgres;Password=change-me
